import { useState } from "react";
import { RecommendationFeedbackRequest, RecommendationFeedbackResponse } from "../types/recommendationFeedback";
import { submitRecommendationFeedback } from "../api/recommendationFeedbackApi";

export function useRecommendationFeedback(recommendationId: string, token?: string) {
    const [data, setData] = useState<RecommendationFeedbackResponse | null>(null);
    const [loading, setLoading] = useState<boolean>(false);
    const [error, setError] = useState<string | null>(null);

    const submit = async (request: RecommendationFeedbackRequest) => {
        if (loading) {
            return;
        }

        setLoading(true);
        try {
            const response = await submitRecommendationFeedback(recommendationId, request, token);
            setData(response);
            setError(null);
        } catch (e: any) {
            setError(e.message || "Failed to submit feedback");
        } finally {
            setLoading(false);
        }
    };

    return { data, loading, error, submit };
}
