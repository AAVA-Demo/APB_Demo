{
  "name": "creditcard-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright automation for Credit Card Dashboard application",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dashboard": "playwright test dashboard.spec.js",
    "test:cards": "playwright test cardManagement.spec.js",
    "test:analytics": "playwright test transactionAnalytics.spec.js",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "credit-card",
    "dashboard"
  ],
  "author": "DevOps Integration Team",
